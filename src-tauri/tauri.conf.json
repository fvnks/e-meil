{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "e-Meil",
  "version": "0.1.3",
  "identifier": "org.emeil.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "e-Meil",
        "width": 400,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "e-Meil",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://login.microsoftonline.com; font-src 'self' https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost https://login.microsoftonline.com https://graph.microsoft.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mailto"]
      }
    },
    "updater": {
      "endpoints": ["https://github.com/fvnks/e-meil/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyOUREMzk5MkYzNzQ0QzAKUldUQVJEY3ZtZE9kd3E3bGlnS2h6NnU5aXNlYUhEU3FrVjA5WEswNnVnYUMzdlhTU2xCeHh6Wm4K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}


